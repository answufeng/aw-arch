<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aw_demo_surface_muted">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/aw_demo_bg">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/demo_awnav_basic_title"
            app:titleTextColor="@color/aw_demo_on_surface" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 路由状态栏：由 currentRouteFlow 驱动 -->
        <TextView
            android:id="@+id/tvNavStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/aw_demo_log_bg"
            android:paddingHorizontal="@dimen/demo_space_md"
            android:paddingVertical="@dimen/demo_space_sm"
            android:textColor="@color/aw_demo_on_surface_muted"
            android:textSize="12sp" />

        <!-- 第一行：基础导航 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/demo_space_sm"
            android:background="@color/aw_demo_surface"
            android:elevation="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHome"
                style="@style/Widget.AwArchDemo.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_awnav_btn_home"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetail"
                style="@style/Widget.AwArchDemo.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/demo_space_sm"
                android:layout_weight="1"
                android:text="@string/demo_awnav_btn_detail"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.AwArchDemo.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/demo_space_sm"
                android:layout_weight="1"
                android:text="@string/demo_awnav_btn_settings"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.AwArchDemo.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/demo_space_sm"
                android:layout_weight="1"
                android:text="@string/demo_awnav_btn_back"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- 第二行：高级操作 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/demo_space_sm"
            android:paddingEnd="@dimen/demo_space_sm"
            android:paddingBottom="@dimen/demo_space_sm"
            android:background="@color/aw_demo_surface"
            android:elevation="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackTo"
                style="@style/Widget.AwArchDemo.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_awnav_btn_back_to"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearStack"
                style="@style/Widget.AwArchDemo.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/demo_space_sm"
                android:layout_weight="1"
                android:text="@string/demo_awnav_btn_clear_stack"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSingleTop"
                style="@style/Widget.AwArchDemo.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/demo_space_sm"
                android:layout_weight="1"
                android:text="@string/demo_awnav_btn_single_top"
                android:textSize="11sp" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
