<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aw_demo_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/aw_demo_bg"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/aw_demo_on_surface"
        app:titleTextColor="@color/aw_demo_on_surface" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/demo_space_md">

            <TextView
                android:id="@+id/tvBreadcrumb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/aw_demo_on_surface_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvArgs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/demo_space_sm"
                android:background="@color/aw_demo_log_bg"
                android:padding="@dimen/demo_space_sm"
                android:textColor="@color/aw_demo_on_surface_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvStackInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/demo_space_sm"
                android:textColor="@color/aw_demo_on_surface_muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoDeeper"
                style="@style/Widget.AwArchDemo.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/demo_space_md"
                android:text="@string/demo_nav_detail_go_deeper" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToHome"
                style="@style/Widget.AwArchDemo.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/demo_space_sm"
                android:text="@string/demo_nav_detail_back_to_home" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearAndNavigate"
                style="@style/Widget.AwArchDemo.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/demo_space_sm"
                android:text="@string/demo_nav_detail_clear_navigate" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
