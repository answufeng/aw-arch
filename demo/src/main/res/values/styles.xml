<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.AwArchDemo.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/aw_demo_on_surface_muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Widget.AwArchDemo.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.AwArchDemo.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.AwArchDemo.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/aw_demo_divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/aw_demo_surface</item>
    </style>

    <style name="Widget.AwArchDemo.Card.Home" parent="Widget.AwArchDemo.Card">
        <item name="cardElevation">1dp</item>
    </style>

    <style name="Widget.AwArchDemo.Card.Hero" parent="Widget.AwArchDemo.Card">
        <item name="cardBackgroundColor">@color/aw_demo_hero_gradient_start</item>
    </style>

    <style name="Widget.AwArchDemo.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

</resources>
